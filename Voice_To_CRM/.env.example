# Copy this file to .env and fill in your values. Never share or commit .env.

# --- Flask ---
# SECRET_KEY=any-long-random-string      (optional; auto-generated into instance/ if empty)
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# --- Database ---
# Leave MYSQL_DATABASE empty to use SQLite (zero setup).
# Fill it in to use MySQL (tables are created automatically).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- AI: speech-to-text and field extraction ---
# Without a key the app still works: type or dictate notes, and basic extraction is used.
#
# FREE option (Groq): get a key at https://console.groq.com  ->  API Keys, then:
#   GROQ_API_KEY=gsk_your_key_here
# PAID option (OpenAI): put your key here instead:
#   OPENAI_API_KEY=sk-your_key_here
# The provider is picked from the key. To force it: AI_PROVIDER=groq  or  AI_PROVIDER=openai
GROQ_API_KEY=
OPENAI_API_KEY=
# AI_PROVIDER=
# Optional overrides: OPENAI_BASE_URL, OPENAI_TRANSCRIBE_MODEL, OPENAI_CHAT_MODEL
# TRANSCRIBE_LANGUAGE=hi        (optional hint: en, hi, ...; blank = auto-detect)

# --- App ---
ALLOW_REGISTRATION=true
# People can choose "Administrator" on the sign-up page only if they type this secret code.
# The first account ever created is always the administrator. Blank = no one else can sign up as admin.
ADMIN_SIGNUP_CODE=

# --- Email reminders (optional) ---
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character App Password> (needs 2-step verification turned on).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls     # starttls (port 587), ssl (port 465) or none
SMTP_FROM=                 # defaults to SMTP_USER
REMINDER_DAYS_AHEAD=1      # also remind about follow-ups due within this many days
